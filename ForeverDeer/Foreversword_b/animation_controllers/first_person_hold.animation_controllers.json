{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.mc.forever_spear.first_person_hold": {
            "initial_state": "default",
            "states": {
                "default": {
                    "animations": [
                        "first_person_hold"
                    ],
                    "transitions": [
                        {
                            "hold": "query.is_using_item"
                        }
                    ]
                },
                "hold": {
                    "animations": [
                        "first_person_hold"
                    ]
                }
            }
        }
    }
}